# Local development. Use a separate .env and new secrets for deployment.
DB_NAME=dietreminder
DB_USERNAME=dietreminder
DB_PASSWORD=local-development-change-me
DB_PORT=5432
BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1

# Development mailbox: captures recovery emails at http://localhost:8025.
COMPOSE_PROFILES=dev
SPRING_MAIL_HOST=mail
SPRING_MAIL_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
AUTH_MAIL_FROM=no-reply@dietreminder.local
# For deployment: COMPOSE_PROFILES=, real SMTP host/port/credentials,
# SMTP_AUTH=true, SMTP_STARTTLS=true, AUTH_MAIL_FROM on your domain.
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Local HTTP only. Use true with HTTPS in deployment.
WEB_SECURE_COOKIES=false
WEB_PORT=8088
WEB_BIND_ADDRESS=127.0.0.1
# The OAuth Web client ID is shared with Android Credential Manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8088/api/google/drive/callback
# Generate once: openssl rand -base64 32. Keep the same key with the database.
GOOGLE_TOKEN_ENCRYPTION_KEY=
