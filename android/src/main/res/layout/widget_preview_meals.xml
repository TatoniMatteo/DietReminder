<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="250dp" android:minHeight="200dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_preview_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/brand_logo" android:importantForAccessibility="no" />
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/next_meal" android:textColor="#e9e9f2" android:textSize="14sp" android:textStyle="bold" />
  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_open" android:importantForAccessibility="no" />
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/meal_lunch" android:textColor="#e9e9f2" android:textSize="21sp" android:textStyle="bold" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_preview_meal_detail" android:textColor="#91e7a6" android:textSize="14sp" />
 <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_previous" android:importantForAccessibility="no" />
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_next_default" android:textColor="#91e7a6" android:textSize="12sp" android:textStyle="bold" />
  <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_next" android:importantForAccessibility="no" />
 </LinearLayout>
</LinearLayout>
