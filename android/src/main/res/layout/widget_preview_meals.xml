<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="250dp" android:minHeight="200dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_preview_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/meal_lunch" android:textColor="#E2EBE2" android:textSize="15sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_meal" android:textColor="#BCCBBC" android:textSize="11sp" />
  </LinearLayout>
  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_open" android:importantForAccessibility="no" />
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:text="@string/widget_preview_meal_detail" android:textColor="#E2EBE2" android:textSize="22sp" android:textStyle="bold" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/widget_previous" android:importantForAccessibility="no" />
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:gravity="center" android:text="@string/widget_next_default" android:textColor="#D0E8D3" android:textSize="12sp" android:textStyle="bold" />
  <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/widget_next" android:importantForAccessibility="no" />
 </LinearLayout>
</LinearLayout>
