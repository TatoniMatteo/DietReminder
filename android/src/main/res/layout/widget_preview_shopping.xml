<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="250dp" android:minHeight="200dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_preview_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_shopping" android:textColor="#E2EBE2" android:textSize="15sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_shopping_detail" android:textColor="#BCCBBC" android:textSize="11sp" />
  </LinearLayout>
  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_open" android:importantForAccessibility="no" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:padding="8dp" android:orientation="horizontal" android:gravity="top">
  <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/widget_unchecked" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="6dp" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_food" android:textColor="#E2EBE2" android:textSize="14sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_shopping_detail" android:textColor="#BCCBBC" android:textSize="11sp" />
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
