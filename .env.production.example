# Copy to .env and replace secrets before starting. No development mailbox.
RELEASE_TAG=2.0.1
DB_NAME=dietreminder
DB_USERNAME=dietreminder
DB_PASSWORD=
# One published port behind your HTTPS reverse proxy. Backend/PostgreSQL have none.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
WEB_SECURE_COOKIES=true
AUTH_MAIL_FROM=Memo Pasti <no-reply@example.com>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://dietreminder.example.com/api/google/drive/callback
# Generate once with openssl rand -base64 32 and retain with your database.
GOOGLE_TOKEN_ENCRYPTION_KEY=
